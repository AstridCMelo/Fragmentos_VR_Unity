  npcName: "Mam\xE1"
  playerName: Hijo
  npcPortrait: {fileID: 21300000, guid: adaef6de483e8e44fae13a41f66d00db, type: 3}
  playerPortrait: {fileID: 0}
  dialogueblockNPC:
  - dialogueLinesNPC:
    - "Llegaste\u2026 pens\xE9 que te ibas a tardar m\xE1s. "
    - "Mam\xE1\u2026 \xBFqu\xE9 est\xE1 pasando? "
    - Nada que no haya pasado antes.
    NPCorPlayerDialogLine: 010001
    dialogueVoicesNPC:
    - {fileID: 8300000, guid: adf5647f7abea6e44bf87e75de323433, type: 3}
    - {fileID: 0}
    - {fileID: 8300000, guid: da2a55dcc244dc647bd11817b497db73, type: 3}
    dialogueBlockState: 0
  - dialogueLinesNPC:
    - 'No logro hacerlo funcionar. '
    - "Porque lo est\xE1s forzando. "
    - " Entonces, \xBFc\xF3mo? "
    - "Como cuando busc\xE1bamos una emisora. "
    NPCorPlayerDialogLine: 00010001
    dialogueVoicesNPC: []
    dialogueBlockState: 1
  - dialogueLinesNPC:
    - "Creo que estoy cerca\u2026 "
    - "No pienses tanto\u2026 escucha. "
    NPCorPlayerDialogLine: 0001
    dialogueVoicesNPC: []
    dialogueBlockState: 1
  - dialogueLinesNPC:
    - "\u2026ya. "
    - "\xBFVes? Nunca se fue. "
    NPCorPlayerDialogLine: 0001
    dialogueVoicesNPC: []
    dialogueBlockState: 2
